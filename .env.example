# larkBot 配置
# 运行 make init 交互式生成，或手动编辑此文件

# LLM 提供商: anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic (LLM_PROVIDER=anthropic 时必填)
ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=           # 兼容 API: 自定义 Base URL

# OpenAI / 兼容 API (LLM_PROVIDER=openai 时必填)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=              # DeepSeek: https://api.deepseek.com

# 模型名 (留空则使用 provider 默认值)
LLM_MODEL=claude-sonnet-4-20250514

# Bot 设置
MAX_HISTORY=30
LOG_DIR=./logs
TOOL_TIMEOUT=30
MAX_RETRIES=1
MAX_AGENT_ROUNDS=15
HOOKS_CUSTOM_DIR=./hooks_custom
